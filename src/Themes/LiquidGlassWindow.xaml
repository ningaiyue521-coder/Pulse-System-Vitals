<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:DemoApp.Behaviors"
                    xmlns:commands="clr-namespace:DemoApp.Commands">

    <SolidColorBrush x:Key="WindowChromeFill" Color="#13FFFFFF" />
    <SolidColorBrush x:Key="HeaderGlassFill" Color="#A9FFFFFF" />
    <LinearGradientBrush x:Key="GlassCardEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9FFFFFFF" Offset="0" />
        <GradientStop Color="#64FFFFFF" Offset="0.48" />
        <GradientStop Color="#38344252" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WindowFrameEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A5FFFFFF" Offset="0" />
        <GradientStop Color="#58FFFFFF" Offset="0.42" />
        <GradientStop Color="#2A88C7F4" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WindowOpticalEdgeBrush" StartPoint="0,0" EndPoint="0.92,1">
        <GradientStop Color="#9AFFFFFF" Offset="0" />
        <GradientStop Color="#35CDEFFF" Offset="0.53" />
        <GradientStop Color="#34A9B8FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WindowInnerCausticBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4C82DAFF" Offset="0" />
        <GradientStop Color="#24FFFFFF" Offset="0.28" />
        <GradientStop Color="#00FFFFFF" Offset="0.53" />
        <GradientStop Color="#20B1A2FF" Offset="0.78" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <Thickness x:Key="WindowOpticalEdgeThickness">1.4</Thickness>
    <Thickness x:Key="WindowInnerCausticThickness">1</Thickness>
    <LinearGradientBrush x:Key="WindowSpecularBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#A2FFFFFF" Offset="0.2" />
        <GradientStop Color="#74FFFFFF" Offset="0.72" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="WindowFrameBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource WindowFrameEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="Background" Value="{DynamicResource WindowChromeFill}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="Background" Value="#38FFFFFF" />
        <Setter Property="BorderBrush" Value="#78FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#A51D1D1F" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="ButtonBody" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                        <Border x:Name="Root"
                                CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border CornerRadius="16" IsHitTestVisible="False" Opacity="0.40">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#D8FFFFFF" Offset="0" />
                                    <GradientStop Color="#18FFFFFF" Offset="0.6" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#A8FFFFFF" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#E8FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBody" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.90" ScaleY="0.90" /></Setter.Value>
                            </Setter>
                            <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MaximizeCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}" />

    <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="#42FF6B64" />
        <Setter Property="BorderBrush" Value="#74FFFFFF" />
        <Setter Property="Foreground" Value="#C52B1A1A" />
    </Style>

    <Style x:Key="GlassyWindowStyle" TargetType="Window">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="behaviors:GlassyWindowBehavior.Enable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border x:Name="ShadowHost" Margin="0" Background="Transparent">
                        <Border x:Name="WindowFrame"
                                Style="{StaticResource WindowFrameBorder}"
                                commands:WindowCommands.DragMove="True">
                            <Grid x:Name="WindowClipRoot" ClipToBounds="True">
                                <Border x:Name="GlassTintLayer"
                                        Panel.ZIndex="2"
                                        CornerRadius="26"
                                        Background="{DynamicResource WindowGlassOverlay}"
                                        IsHitTestVisible="False" />

                                <Border x:Name="GlassOpticalEdge"
                                        Panel.ZIndex="16"
                                        Margin="2"
                                        CornerRadius="24"
                                        BorderThickness="{DynamicResource WindowOpticalEdgeThickness}"
                                        BorderBrush="{DynamicResource WindowOpticalEdgeBrush}"
                                        CacheMode="BitmapCache"
                                        IsHitTestVisible="False" />

                                <Border x:Name="GlassInnerCaustic"
                                        Panel.ZIndex="16"
                                        Margin="4"
                                        CornerRadius="22"
                                        BorderThickness="{DynamicResource WindowInnerCausticThickness}"
                                        BorderBrush="{DynamicResource WindowInnerCausticBrush}"
                                        CacheMode="BitmapCache"
                                        IsHitTestVisible="False" />

                                <Border Panel.ZIndex="17"
                                        Height="2"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top"
                                        Margin="48,3,166,0"
                                        Background="{DynamicResource WindowSpecularBrush}"
                                        CacheMode="BitmapCache"
                                        IsHitTestVisible="False" />

                                <ContentPresenter x:Name="FunctionalContentLayer" Panel.ZIndex="10" />

                                <Border Panel.ZIndex="24"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,10,14,0"
                                        Padding="5"
                                        CornerRadius="21"
                                        Background="{DynamicResource HeaderGlassFill}"
                                        BorderBrush="{DynamicResource GlassCardEdge}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource CaptionButtonStyle}"
                                                ToolTip="迷你监控"
                                                AutomationProperties.Name="最小化为迷你监控"
                                                commands:WindowCommands.Minimize="True">
                                            <Viewbox Width="12" Height="12">
                                                <Path Data="M 1 7 L 13 7" Stroke="#C81D1D1F" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Viewbox>
                                        </Button>
                                        <Button x:Name="MaximizeButton"
                                                Style="{StaticResource MaximizeCaptionButtonStyle}"
                                                ToolTip="最大化或还原"
                                                AutomationProperties.Name="最大化或还原"
                                                commands:WindowCommands.MaximizeRestore="True">
                                            <Viewbox Width="12" Height="12">
                                                <Path Data="M 1.5 1.5 L 12.5 1.5 L 12.5 12.5 L 1.5 12.5 Z" Stroke="#C81D1D1F" StrokeThickness="1.45" StrokeLineJoin="Round" Fill="Transparent" />
                                            </Viewbox>
                                        </Button>
                                        <Button Style="{StaticResource CloseCaptionButtonStyle}"
                                                ToolTip="关闭"
                                                AutomationProperties.Name="关闭"
                                                commands:WindowCommands.Close="True">
                                            <Viewbox Width="12" Height="12">
                                                <Path Data="M 2 2 L 12 12 M 12 2 L 2 12" Stroke="#D42B1A1A" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Panel.ZIndex="50"
                                        BorderThickness="6"
                                        BorderBrush="Transparent"
                                        commands:WindowCommands.Resize="True" />
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="ShadowHost" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
