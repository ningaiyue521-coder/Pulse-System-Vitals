<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Pulse</AssemblyName>
    <RootNamespace>DemoApp</RootNamespace>
    <Version>3.3.0</Version>
    <FileVersion>3.3.0.0</FileVersion>
    <Product>Pulse System Vitals</Product>
    <Description>DWM clear-glass system monitor with timer-free liquid typography and a compact functional-layer OSD.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" Condition="'$(PublishSingleFile)' != 'true'" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" Condition="'$(PublishSingleFile)' != 'true'" />
    <Resource Include="LICENSE" Condition="'$(PublishSingleFile)' == 'true'" />
    <Resource Include="THIRD-PARTY-NOTICES.md" Condition="'$(PublishSingleFile)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>

</Project>
